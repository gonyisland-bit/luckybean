    "tagline.cardHug": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "남의 비둘기를 지목해요 · 카드 품은 비둘기 주인이 쏴요"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ほかのハトを指名・カードを抱えたハトの持ち主のおごり"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Point at someone else's pigeon · the card-holder's owner pays"
          }
        }
      }
    },
    "tagline.roastRoulette": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "손 안 대고 구경만 · 바닥에 드러난 이름이 쏴요"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "見てるだけ・底に出た名前の人のおごり"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Just watch · the name under the beans pays"
          }
        }
      }
    },
    "tagline.kiriChoice": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
